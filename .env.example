# Copy to .env (gitignored) so raw `docker compose` picks these up, or rely on
# the `just compose-*` recipes which set sensible local defaults.

# Absolute host path bind-mounted into the core at the SAME path (path parity for
# nested `docker run -v` when the core launches stack containers). REQUIRED.
MEDMCP_WORKSPACE=/abs/path/to/workspace

# Where the bundled Ollama keeps models. Default is the named volume
# `ollama-models` (fresh pull on first run). Point at an existing host store to
# reuse an already-pulled model, e.g.:
# OLLAMA_MODELS_DIR=/home/youruser/.ollama

# Pin the Ollama image (default: ollama/ollama:latest).
# OLLAMA_IMAGE=ollama/ollama:0.13.0

# Base image the core/stack builds derive from (default: medmcp-base:dev).
# MEDMCP_BASE_IMAGE=ghcr.io/medmcp/base:dev

# Docker socket the core mounts to launch sibling stack containers. Defaults to
# the rootless path ${XDG_RUNTIME_DIR}/docker.sock. On ROOTFUL Docker, set:
# MEDMCP_DOCKER_SOCK=/var/run/docker.sock

# Behind a TLS-intercepting proxy, add `-f docker-compose.proxy.yml` and point
# this at a CA bundle that trusts your proxy (the host bundle usually does):
# MEDMCP_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
