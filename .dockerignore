# Build context hygiene — keep images small and builds fast.
.git
.github
.idea
.vscode

# Python / uv runtime + caches
.venv
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info

# Node / frontend build artifacts (rebuilt inside the image)
frontend/node_modules
frontend/dist

# Local runtime state (transcripts, provenance, workflows — may contain PII)
.vibe/logs
.vibe/vibehistory
.vibe/trusted_folders.toml
.vibe/provenance
.vibe/workflows
.vibe/ui_sessions.json
.vibe/*_enabled.json
.vibe/active_*.json

# Workspace data (bind-mounted at runtime, never baked)
data
.files

# Docs not needed at build (note: .vibe/prompts/*.md and README.md must remain)
docs/
