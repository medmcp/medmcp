# Custom Gemma 4 configuration for medmcp tool-calling.
#
# Gemma 4 26B is Google's instruction-tuned model with native function-calling support.
#
# num_ctx 32768; keeps ample room for MCP tool schemas (~1500 tokens), the system prompt, and multi-turn dialogue.
#
# Low temperature for deterministic tool-call argument generation.
# repeat_penalty + repeat_last_n guard against open-ended generation loops
#
# Build with:
#   ollama create gemma4-medmcp -f Modelfile.gemma4

FROM gemma4:26b

PARAMETER num_ctx 32768
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64
PARAMETER repeat_penalty 1.15
PARAMETER repeat_last_n 256
PARAMETER num_predict 2048
