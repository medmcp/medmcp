 "rules": {
  "drop_localizers_derived": "drop localizers and masks; drop derived or reformatted series unless every remaining candidate is one (then the row is only_derived)",
  "requested_plane": "keep the plane the selection criteria asked for (the first listed plane that a candidate has)",
  "identical_copies": "the same acquisition stored more than once (same series number, acquisition time and geometry, other series UID or description) counts once",
  "complementary_series": "stop when candidates differ only in a phase-encoding direction (AP/PA/RL/LR) or b-value: they belong together, they are not alternatives",
  "same_station": "stop when the candidates cover different stations along the body (z-extents overlap less than 80 % of the smaller one, e.g. C-, T- and L-spine): multiple_stations",
  "full_coverage": "drop candidates covering less than 50 % of the largest through-plane extent (add-on, partial or needle-check series); a pick under 60 % is flagged",
  "prefer_3d": "prefer 3D acquisitions (MRAcquisitionType, else isotropic spacing) over 2D",
  "thinnest_slices": "prefer the thinnest slices",
  "highest_inplane_resolution": "prefer the smallest in-plane voxel area",
  "latest_series": "prefer the latest series of the session (highest series number, else latest acquisition time)"
 },
