# Copy to .env (gitignored) so raw `docker compose` picks these up, or rely on
# the `just compose-*` recipes which set sensible local defaults.

# Absolute host path bind-mounted into the core at the SAME path (path parity for
# nested `docker run -v` when the core launches stack containers). REQUIRED.
MEDMCP_WORKSPACE=/abs/path/to/workspace

# Where the bundled Ollama keeps models. Default is the named volume
# `ollama-models` (fresh pull on first run). Point at an existing host store to
# reuse an already-pulled model, e.g.:
# OLLAMA_MODELS_DIR=/home/youruser/.ollama

# Pin the Ollama image (default: ollama/ollama:latest).
# OLLAMA_IMAGE=ollama/ollama:0.13.0

# GPU the LLM service and GPU stacks target (CDI device id). Default: all GPUs.
# Pin to a single GPU by index or UUID (`nvidia-smi -L`), e.g.:
# MEDMCP_GPU=0

# Optional: log in to the registry from inside the core. The published images
# pull anonymously, so this is only needed for a private mirror or your own
# non-public stack images — in particular on hosts whose docker config uses a
# credential helper, leaving no plaintext auths to mount. Use a read:packages
# token. Leave unset to rely on the host's `docker login`.
# GHCR_USER=your-github-user
# GHCR_TOKEN=ghp_...

# Base image the core/stack builds derive from (default: medmcp-base:dev).
# MEDMCP_BASE_IMAGE=ghcr.io/medmcp/base:dev

# Route the agent's model traffic through the tool-call repair shim. Ollama's
# Glimmer parser drops many tool calls and ends the stream without an error, so
# the chat answers nothing at all; the shim repairs and retries those turns.
# Set to 1 to enable.
# MEDMCP_LLM_SHIM=1
